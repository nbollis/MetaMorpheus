<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release</Configurations>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Left architecture-neutral (no PlatformTarget) so the CLI can run on arm64; see CMD.csproj. -->

  <ItemGroup>
    <None Remove="ParallelSearch\Resources\AllBacteriaKey_WithTaxonomy.tsv" />
    <None Remove="ParallelSearch\Resources\AllChordataKey_WithTaxonomy.tsv" />
    <None Remove="ParallelSearch\Resources\AllVirusesKey_WithTaxonomy.tsv" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ParallelSearch\Resources\AllBacteriaKey_WithTaxonomy.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="ParallelSearch\Resources\AllChordataKey_WithTaxonomy.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="ParallelSearch\Resources\AllVirusesKey_WithTaxonomy.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />
    <PackageReference Include="Microsoft.ML.CpuMath" Version="3.0.1" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="3.0.1" />
    <PackageReference Include="mzLib" Version="1.0.597" />
    <PackageReference Include="NetSerializer" Version="4.1.2" />
    <PackageReference Include="Nett" Version="0.15.0" />
    <PackageReference Include="SQLite.Interop.dll" Version="1.0.103" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EngineLayer\EngineLayer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ParallelSearch\wiki\" />
  </ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Test" />
	</ItemGroup>

</Project>
